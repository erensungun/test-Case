{
  "info": {
    "_postman_id": "8a1c2e14-9bde-4f60-a9e0-9c3b5c9d1010",
    "name": "test-Case API",
    "description": "Pure PHP RESTful E-Commerce API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/test-Case/public"
    },
    {
      "key": "sessionId",
      "value": "eren-1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Ping",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/ping"
          }
        },
        {
          "name": "WhoAmI",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/whoami"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?page=1&limit=10"
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?search=saat"
          }
        },
        {
          "name": "Product Detail (id=1)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products/1"
          }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/categories"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "View Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Add Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/api/cart/items"
          }
        },
        {
          "name": "Update Item Quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": "{{baseUrl}}/api/cart/items/1"
          }
        },
        {
          "name": "Remove Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart/items/1"
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart"
          }
        }
      ]
    },
    {
      "name": "Coupons",
      "item": [
        {
          "name": "Apply Coupon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"WELCOME10\"\n}"
            },
            "url": "{{baseUrl}}/api/cart/coupon"
          }
        },
        {
          "name": "Remove Coupon",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/cart/coupon"
          }
        }
      ]
    },
    {
      "name": "Favorites",
      "item": [
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/favorites"
          }
        },
        {
          "name": "Add Favorite",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": 2\n}"
            },
            "url": "{{baseUrl}}/api/favorites"
          }
        },
        {
          "name": "Remove Favorite",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/favorites/2"
          }
        },
        {
          "name": "Favorite → Add To Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Session-Id",
                "value": "{{sessionId}}"
              }
            ],
            "url": "{{baseUrl}}/api/favorites/2/add-to-cart"
          }
        }
      ]
    }
  ]
}
